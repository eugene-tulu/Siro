# Siro — OmniBid AI Hackathon Project

# TypeSafe AI (Jev) — add before judging
TYPESAFE_API_KEY=

# Livepeer Agent — omit both keys to use keyless demo credits.
# Request an email code from the dashboard (or POST /api/activation/request),
# then redeem it (POST /api/activation/activate). Same flow as agent.livepeer.org/get-started.html
# Optional: a real key skips the email gate and bills that account instead.
DEMO_RENDER_KEY=
LIVEPEER_DAYDREAM_KEY=

# Server
PORT=3000
NODE_ENV=development
